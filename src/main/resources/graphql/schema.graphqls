type Query{
    cars: [Car],
    buses: [Bus],
    onRoadCars(state:Boolean): [Car],
    findByVisitedCountries(countries:[String!]!):[Car!],
    findBusByCapacity(capacity:Int):[Bus!]!,
    findCarByID(carID: Int):Car!,
    getCarsFromIDCache(carID: Int):Car!,
    getAllCarsFromIDCache:[Car!]!,

}
type Mutation{
    addCar(car: CarInput): Car
}

input CarInput{
    id: ID!
    name: String!
    model: Int!
    owner: OwnerInput!

}
input OwnerInput{
    id: Int!
    name: String!
    phoneNumber: String!
}

type Owner{
    id: Int!
    name: String!
    phoneNumber: String!
}

type Car{
    id: ID!
    name: String!
    model: Int!
    owner: Owner!
}
type Bus{
    id: ID!
    name: String!
    model: Int!
    capacity: Int!
}